# dependencies (bun install)
node_modules

# Google Cloud service account credentials
g-auth.json

# output
out
dist
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# AI memory snapshots + daily luck cache (diskIOWorker, same privacy tier as logs)
memory

# SQLite identity policy storage (diskIOWorker, same privacy tier as memory/).
# 必须锚定根目录，避免吞掉 packages/database/ 下的 Drizzle schema 与 codec 源码。
/database/

# 全量性能基准的 mock 数据根（scripts/perf/fullSuite.ts）。运行期在这里建
# SQLite、memory/、logs/ 与 state.json，跑完即删；一次都不该进版本库。
# 必须锚定根目录，理由同上面的 /database/ 与 /config。
/performance/

# unexpected local dotenv files (not runtime config; keep accidental secrets out of Git)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# deployment configuration (copy and customize config_example/)
# 必须锚定根目录：裸 `config` 会匹配任意层级的同名目录，把 packages/config/ 与
# test/config/ 下的新增源码一并静默忽略（既有文件因已被跟踪而不受影响，问题只
# 在新增时暴露）。
/config

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# AI local settings
.claude
.agents
.codex

# 本地临时的任务/审查笔记，不进版本库
todo.md
plan.md
review.md

# Finder (MacOS) folder config
.DS_Store

# runtime state (regenerated on start, not source)
bot.lock
bot.lock.*
state.json
state.json.bak
state.json.*.corrupt
.state.json.*.tmp
