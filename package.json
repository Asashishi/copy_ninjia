    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "@google-cloud/translate": "^9.4.2",
    "@google/genai": "^2.12.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "grammy": "^1.44.0",
    "sharp": "^0.35.3"
  }
