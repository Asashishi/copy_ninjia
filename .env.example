# Telegram Bot API token
TELEGRAM_BOT_TOKEN=

# Google Gemini API key —— AI 闲聊 agent 的默认供应商：/ai_chat 的回复生成、图片理解、
# 记忆压缩、生图。可选；配了就用它，与下面的 OpenAI 那把是「或」的关系
AI_CHAT_GEMINI_API_KEY=

# OpenAI API key —— AI 闲聊 agent 的降级供应商，能力与 Gemini 那份一一对应。可选，
# 只有 AI_CHAT_GEMINI_API_KEY 留空时才轮到它；两把都留空时 AI Worker 不启动、
# /ai_chat enable 与 /switch_mood 会被拒绝，其余功能照常运行。
# 注意两处不对等：OpenAI 侧没有可调的内容过滤档位，生图只有三种画幅
AI_CHAT_OPENAI_API_KEY=

# 注意：OpenAI 兼容线的**接口地址与模型名**不在 .env，而在 config/openai.json
# （ad_detect 与 ai_agent 两个对象各配各的）。这份文件**必填**，代码里不再持有任何
# 模型默认值：缺文件、缺自己那一段、缺模型名，都会让对应功能被判为不可用并拒绝启动。
# 可省的只有两处端点：ad_detect.base_url 缺省走 DeepSeek 官方地址，ai_agent.base_url
# 缺省走 SDK 自带的官方端点。Gemini 的模型名另见 config/gemini.json。.env 只留凭据

# DeepSeek API key（OpenAI 兼容接口）—— 广告检测专用：/ad_detect 的判定。可选，
# 留空时 /ad_detect enable 会被拒绝，其余功能照常运行
AD_DETECT_DEEPSEEK_API_KEY=

# 超级管理员的单个数字 ID。这个身份本身即持有 config/whitelist.json 能授予的全部
# 逐项权限，不必也不应在那份文件里另配条目；/init、/batch_kick、/permission 的
# 修改操作、/white 与 /send 则只认这个身份，无法通过白名单授权出去
SUPER_ADMIN_USER_ID=

# 可选：state/lock/logs/memory 的运行时数据根目录；留空时使用项目根目录
# COPY_NINJIA_DATA_ROOT=/var/lib/copy-ninjia
