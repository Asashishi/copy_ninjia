# Telegram Bot API token
TELEGRAM_BOT_TOKEN=

# Google Gemini API key —— AI 闲聊 agent 专用：/ai_chat 的回复生成、图片理解、记忆压缩。可选，
# 留空时 AI Worker 不启动、/ai_chat enable 与 /switch_mood 会被拒绝，其余功能照常运行
AI_CHAT_GEMINI_API_KEY=

# DeepSeek API key（OpenAI 兼容接口）—— 广告检测专用：/ad_detect 的判定。可选，
# 留空时 /ad_detect enable 会被拒绝，其余功能照常运行
AD_DETECT_DEEPSEEK_API_KEY=

# 超级管理员的单个数字 ID
SUPER_ADMIN_USER_ID=

# 可选：state/lock/logs/memory 的运行时数据根目录；留空时使用项目根目录
# COPY_NINJIA_DATA_ROOT=/var/lib/copy-ninjia
