# Telegram Bot API token
TELEGRAM_BOT_TOKEN=

# Google Gemini API key —— AI 闲聊 agent 专用：/ai_chat 的回复生成、图片理解、记忆压缩。必填
GEMINI_API_KEY=

# DeepSeek API key（OpenAI 兼容接口）—— 广告检测专用：/ad_detect 的判定。可选，
# 留空时 /ad_detect enable 会被拒绝，其余功能照常运行
DEEPSEEK_API_KEY=

# 白名单用户数字 ID（copy 冷却豁免、/block、为其他 Bot 代点验证），英文逗号分隔
PRIVILEGED_USERS_ID=

# 超级管理员的单个数字 ID
SUPER_ADMIN_USER_ID=

# 可选：state/lock/logs/memory 的运行时数据根目录；留空时使用项目根目录
# COPY_NINJIA_DATA_ROOT=/var/lib/copy-ninjia
